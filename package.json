{
  "name": "balaybalay-whatsapp-bot",
  "version": "1.0.0",
  "description": "BalayBalay WhatsApp AI Bot - Production-ready WhatsApp bot powered by Gemini AI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gemini": "tsx scripts/test-gemini.ts",
    "test:ai": "tsx scripts/test-ai.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "gemini",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "openai": "^7.27.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
