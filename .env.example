PORT=3000
NODE_ENV=development

WHATSAPP_PROVIDER=baileys
WHATSAPP_AUTH_DIR=/app/data/wa-auth

# AI Provider Configuration (vpsmurah / gemini)
AI_PROVIDER=vpsmurah
VPSMURAH_AI_BASE_URL=https://my.vpsmurah.co.id/api/v1
VPSMURAH_AI_API_KEY=
AI_MODEL_CHAIN=gemini-38,gemini-37,gemini-36,gemini-35,qwen3-flash,gpt-5-mini,gpt-4o-mini,mistral-small
AI_MODEL_TIMEOUT_MS=12000

# Direct Google Gemini (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=

RESPOND_IN_PRIVATE=true
MAX_INPUT_CHARS=8000
MAX_HISTORY_MESSAGES=10

SYSTEM_PROMPT=
