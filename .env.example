# Server
PORT=3000
NODE_ENV=development

# VPSMurah WhatsApp Unofficial API
VPSMURAH_API_KEY=
VPSMURAH_WHATSAPP_SEND_URL=https://my.vpsmurah.co.id/api/svc/v1/wa-api/messages
VPSMURAH_WHATSAPP_INBOX_URL=https://my.vpsmurah.co.id/api/svc/v1/wa-api/inbox
VPSMURAH_WEBHOOK_SECRET=

# Polling Settings (Provider charges 1 credit per request; default: 60s, min: 5s)
POLLING_ENABLED=true
POLL_INTERVAL_MS=60000

# Bot Identity
BOT_WHATSAPP_NUMBER=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=

# Bot Behavior
RESPOND_IN_PRIVATE=true
MAX_INPUT_CHARS=8000
MAX_HISTORY_MESSAGES=10
RATE_LIMIT_PER_MINUTE=10

# Custom System Prompt (optional, leave empty for default)
SYSTEM_PROMPT=
