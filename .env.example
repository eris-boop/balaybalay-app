# Server
PORT=3000
NODE_ENV=development

# VPSMurah WhatsApp Unofficial API
VPSMURAH_API_KEY=your_vpsmurah_api_key_here
VPSMURAH_WHATSAPP_SEND_URL=https://my.vpsmurah.co.id/api/service/whatsapp-unofficial/send
VPSMURAH_WEBHOOK_SECRET=

# Bot Identity
BOT_WHATSAPP_NUMBER=628xxxxxxxxxx

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Bot Behavior
RESPOND_IN_PRIVATE=true
MAX_INPUT_CHARS=8000
MAX_HISTORY_MESSAGES=10
RATE_LIMIT_PER_MINUTE=10

# Custom System Prompt (optional, leave empty for default)
SYSTEM_PROMPT=
